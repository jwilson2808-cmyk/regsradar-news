      "documentReference": "SEL-2026-10"
    },
    {
      "id": "fannie-ll-2026-09",
      "agency": "Fannie Mae",
      "category": "GSEs",
      "topic": "Underwriting",
      "updateType": "GSE policy",
      "title": "Lender Letter LL-2026-09 Manual Underwriting Eligibility",
      "summary": "Fannie Mae revised the Eligibility Matrix for manually underwritten loans sold on or after February 22, 2027. The letter addresses credit scores, reserves, two- to four-unit principal residences, cash-out refinancing, and consolidation of manual-underwriting requirements.",
      "publishedDate": "2026-11-04",
      "sourceName": "Fannie Mae",
      "sourceUrl": "https://singlefamily.fanniemae.com/news-events/lender-letter-ll-2026-09-manual-underwriting-eligibility",
      "mortgageRelevance": "Changes to manual mortgage underwriting eligibility and loan-delivery requirements.",
      "verifiedAt": "2026-11-07T16:44:26.514955Z",
      "effectiveDate": "2027-02-22",
      "documentReference": "LL-2026-09"
    },
