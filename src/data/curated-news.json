      "sourceName": "New York DFS",
      "sourceUrl": "https://www.dfs.ny.gov/reports_and_publications/press_releases/pr20260910",
      "mortgageRelevance": "Existing cybersecurity compliance obligations for DFS-covered entities, including covered licensed mortgage businesses.",
